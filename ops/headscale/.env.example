# Basic Headscale docker-compose configuration
#
# Copy this file to `.env` and adjust values if needed.
# These values control only the container ports and a few
# convenience variables. Detailed Headscale behaviour is
# configured in `config/config.yaml`.

# Public URL that Tailscale clients will use to reach Headscale.
# For your setup, we use the public hostname with HTTPS:
HEADSCALE_SERVER_URL=<domain>

# HTTP control-plane port exposed on the host (direct, non-TLS).
# In production you may want to bind this only on localhost or a
# private interface via firewalling.
HEADSCALE_PORT=8080

# gRPC admin port exposed on the host (optional).
HEADSCALE_GRPC_PORT=50443

# Metrics/debug port exposed on the host.
HEADSCALE_METRICS_PORT=9090

# Optional HTTPS reverse proxy for Headscale (nginx).
# If you enable the `headscale-proxy` service in docker-compose,
# these values will control the public HTTPS endpoint.
HEADSCALE_DOMAIN=<domain>
HEADSCALE_HTTPS_PORT=443

# Paths to TLS certificate and key on the host (or bind-mounted
# into the container). Adjust to your own certificate paths.
HEADSCALE_TLS_CERT_PATH=./proxy/certs/fullchain.pem
HEADSCALE_TLS_KEY_PATH=./proxy/certs/privkey.pem
