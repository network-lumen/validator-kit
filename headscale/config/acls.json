{
  "//": [
    "Headscale ACLs for Lumen.",
    "",
    "This is a conservative default that you should adapt to your own",
    "hostnames and namespaces. It assumes:",
    "",
    "- all nodes belong to the `lumen` user/namespace",
    "- validator nodes are named `validator-*`",
    "- sentry nodes are named `sentry-*`",
    "- ops/admin machines are named `ops-*`",
    "",
    "See: https://tailscale.com/kb/1018/acls/ for full syntax."
  ],
  "groups": {
    "group:validators": ["lumen:validator-*"],
    "group:sentries": ["lumen:sentry-*"],
    "group:ops": ["lumen:ops-*"]
  },
  "acls": [
    {
      "//": "Allow sentries to reach validators on any port (P2P, RPC, metrics, etc).",
      "action": "accept",
      "src": ["group:sentries"],
      "dst": ["group:validators:*"]
    },
    {
      "//": "Allow ops machines to reach everything in the tailnet.",
      "action": "accept",
      "src": ["group:ops"],
      "dst": ["*:*"]
    }
  ]
}

